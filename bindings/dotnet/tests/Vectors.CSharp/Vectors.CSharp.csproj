<Project Sdk="Microsoft.NET.Sdk">

  <!-- The battery restores Kembec.SunatSdk from ../artifacts (nuget.config): the .nupkg, not the source.
       net48 runs on Windows only; elsewhere build it with -f net8.0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Kembec.SunatSdk.Vectors</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kembec.SunatSdk" Version="$(SunatSdkVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Security" />
  </ItemGroup>

</Project>
