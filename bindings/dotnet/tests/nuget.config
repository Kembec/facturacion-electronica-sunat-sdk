<?xml version="1.0" encoding="utf-8"?>
<!-- Kembec.* only from the package just packed (bindings/dotnet/artifacts), never from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="artifacts" value="../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="artifacts">
      <package pattern="Kembec.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
