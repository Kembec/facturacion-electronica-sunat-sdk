{
    "name": "kembec/facturacion-electronica-sunat-sdk",
    "description": "PHP client for the sunat-sdk binary: build, sign, zip, send and query SUNAT electronic vouchers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "require-dev": {
        "ext-dom": "*",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": { "Kembec\\SunatSdk\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Kembec\\SunatSdk\\Tests\\": "tests/" }
    },
    "config": { "sort-packages": true }
}
