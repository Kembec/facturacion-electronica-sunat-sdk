{
  "name": "@kembec/facturacion-electronica-sunat-sdk",
  "version": "0.1.0-beta.3",
  "description": "SUNAT (Peru) electronic invoicing for JavaScript and TypeScript, in WebAssembly for Node and the browser: builds and signs the UBL XML of invoices, receipts, credit and debit notes, daily summaries and void communications, zips it, exchanges it with SUNAT's web service through your fetch and reads the CDR.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kembec/facturacion-electronica-sunat-sdk.git",
    "directory": "bindings/wasm/npm"
  },
  "homepage": "https://github.com/Kembec/facturacion-electronica-sunat-sdk#readme",
  "bugs": "https://github.com/Kembec/facturacion-electronica-sunat-sdk/issues",
  "keywords": [
    "sunat",
    "peru",
    "facturacion-electronica",
    "factura-electronica",
    "e-invoicing",
    "ubl",
    "xmldsig",
    "javascript",
    "typescript",
    "nodejs",
    "webassembly",
    "wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "node": "./node.js",
      "default": "./web.js"
    },
    "./wasm": {
      "types": "./wasm.d.ts",
      "default": "./wasm/sunat_sdk_wasm_bg.wasm"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.ts",
    "node.js",
    "web.js",
    "wasm.d.ts",
    "NOTICE",
    "wasm/sunat_sdk_wasm.js",
    "wasm/sunat_sdk_wasm_bg.wasm"
  ]
}
